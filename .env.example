# Backend Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Database
DATABASE_PATH=./database/database.sqlite

# SMTP Configuration (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-username@example.com
SMTP_PASSWORD=your-brevo-smtp-password
SMTP_FROM_EMAIL=noreply@yourfreightcompany.com
SMTP_FROM_NAME=Freight Operations

# Rate Limiting
EMAIL_RATE_LIMIT=50
EMAIL_RATE_WINDOW_MS=60000
MAX_CONCURRENT_EMAILS=5
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=info
LOG_PATH=./logs

# CORS
CORS_ORIGIN=https://yourdomain.com,http://localhost:5173

# Frontend Configuration (Vercel)
VITE_API_URL=https://your-api-domain.com/api